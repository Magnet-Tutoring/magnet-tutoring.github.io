# Magnet Tutoring server configuration. Copy to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection string.
# Local example: postgres://postgres:postgres@localhost:5432/magnet
# Render provides this automatically for its managed Postgres.
DATABASE_URL=postgres://user:password@localhost:5432/magnet

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Email address that should be granted the admin role (via `npm run seed:admin`).
ADMIN_EMAIL=admin@magnettutoring.com

# development | production. In production, cookies are secure and error
# responses never leak stack traces.
NODE_ENV=development

# CSRF strategy: there is no CSRF token. Protection comes from the same-origin
# guard on state-changing /api and /admin requests plus sameSite=lax session
# cookies, so cross-site requests cannot carry a valid session.
